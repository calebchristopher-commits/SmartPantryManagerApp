<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Settings" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Manage app preferences and pantry data." android:textSize="15sp"
            android:paddingTop="4dp" android:paddingBottom="20dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Preferences" android:textSize="18sp" android:textStyle="bold" />
        <Switch android:id="@+id/switchExpiryAlerts" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Expiry-soon alerts"
            android:textSize="16sp" android:paddingTop="12dp" android:paddingBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Keeps the preference available for future expiry reminders. Pantry items can still be stored with an optional expiry date."
            android:textSize="14sp" android:paddingBottom="24dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Pantry data" android:textSize="18sp" android:textStyle="bold" />
        <Button android:id="@+id/btnClearPantry" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Clear All Pantry Items"
            android:layout_marginTop="12dp" />

        <TextView android:id="@+id/txtVersion" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:paddingTop="28dp" />
    </LinearLayout>
</ScrollView>
